@page "{id:int}"
@model DetailsModel
@{
    ViewData["Title"] = Model.Book.Title;
}
<h1>@Model.Book.Title</h1>
<p class="meta">@Model.Book.Author · @Model.Book.Year · @Model.Book.Publisher</p>
<div class="card">
    <h2>Оглавление</h2>
    <div class="toc">@Html.Raw(Model.Book.Toc.Html)</div>
    @if (Model.Headings.Count > 0)
    {
        <h2>Выборка из XML (//h2)</h2>
        <ul>
            @foreach (var heading in Model.Headings)
            {
                <li>@heading</li>
            }
        </ul>
    }
</div>
<p class="actions">
    <a class="btn" href="/Edit/@Model.Book.Id">Изменить</a>
    <a class="btn btn-danger" href="/Delete/@Model.Book.Id">Удалить</a>
    <a class="btn" href="/">К списку</a>
</p>
