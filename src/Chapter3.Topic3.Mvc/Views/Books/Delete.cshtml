@model Book
@{
    ViewData["Title"] = "Удалить";
}
<h1>Удалить «@Model.Title»?</h1>
<p class="meta">@Model.Author · @Model.Year</p>
<form method="post">
    <p class="actions">
        <button class="btn btn-danger" type="submit">Удалить</button>
        <a class="btn" href="/Books/Details/@Model.Id">Отмена</a>
    </p>
</form>
